results/backtest/ledger_*.parquet
results/backtest/weekly_*.parquet
# Run artifacts
outputs/
return_bundle/
executed_notebooks/
logs/
__pycache__/
.ipynb_checkpoints/
.pytest_cache/
*.pyc
.env
.DS_Store
~$*

